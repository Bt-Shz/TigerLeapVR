  - m_Id: 116832062234624
    m_Localized: "\u092A\u0941\u0928\u0903 \u092A\u094D\u0930\u092F\u093E\u0938 \u0915\u0930\u0947\u0902"
    m_Metadata:
      m_Items: []
  - m_Id: 118042370596864
    m_Localized: "\u0916\u0947\u0932\u0928\u0947 \u0915\u093E \u0924\u0930\u0940\u0915\u093E"
    m_Metadata:
      m_Items: []
  - m_Id: 118174243708928
    m_Localized: "1) \u0915\u093E\u0930\u094D\u0921 \u092A\u094B\u091C\u093F\u0936\u0928
      \u092F\u093E\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F
      \u0906\u092A\u0915\u0947 \u092A\u093E\u0938 10 \u0938\u0947\u0915\u0902\u0921
      \u0939\u0948\u0902, \u092B\u093F\u0930 \u0935\u0947 \u092A\u0932\u091F \u091C\u093E\u090F\u0902\u0917\u0947\n2)
      \u0905\u092A\u0928\u0947 \u0939\u093E\u0925 \u092E\u0947\u0902 \u092E\u094C\u091C\u0942\u0926
      \u0915\u093E\u0930\u094D\u0921\u094D\u0938 \u0938\u0947 \u092E\u093F\u0932\u0924\u0947
      \u091C\u094B\u0921\u093C\u0947 \u0916\u094B\u091C\u0928\u0947 \u0915\u0947
      \u0932\u093F\u090F \u0915\u093E\u0930\u094D\u0921\u094D\u0938 \u092A\u0930
      \u0915\u094D\u0932\u093F\u0915 \u0915\u0930\u0947\u0902 (\u0938\u094D\u0915\u094D\u0930\u0940\u0928
      \u0915\u0947 \u0928\u0940\u091A\u0947)\n3) \u0915\u094B\u0936\u093F\u0936\u094B\u0902
      \u0915\u094B \u0915\u092E \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u092E\u092F
      \u0938\u0941\u0927\u093E\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F
      \u092A\u094B\u091C\u093F\u0936\u0928 \u092F\u093E\u0926 \u0930\u0916\u0947\u0902\n4)
      \u0906\u092A\u0915\u094B \u0907\u0938\u0947 \u0938\u092E\u092F \u0938\u0940\u092E\u093E
      \u0915\u0947 \u092D\u0940\u0924\u0930 \u092A\u0942\u0930\u093E \u0915\u0930\u0928\u093E
      \u0939\u094B\u0917\u093E (1 \u092E\u093F\u0928\u091F, 3 \u092E\u093F\u0928\u091F,
      5 \u092E\u093F\u0928\u091F)\n5) \u0915\u092D\u0940 \u092D\u0940 \u092A\u0949\u091C\u093C
      \u092C\u091F\u0928 \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0947\u0902
      \u2013 \u092A\u0949\u091C\u093C \u0915\u0930\u0928\u0947 \u092A\u0930 \u091F\u093E\u0907\u092E\u0930
      \u0930\u0941\u0915 \u091C\u093E\u0924\u093E \u0939\u0948"
    m_Metadata:
      m_Items: []
